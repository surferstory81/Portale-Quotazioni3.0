# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=portale_quotazioni

# ===== App =====
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# ===== Email / SMTP =====
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password-here
SMTP_FROM=Portale Quotazioni <no-reply@example.com>
EMAIL_ADMIN_RECIPIENTS=admin@example.com

# ===== JWT =====
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===== Admin seed =====
ADMIN_MATRICOLA=ADMIN001
ADMIN_EMAIL=admin@quotazioni.local
ADMIN_PASSWORD=Admin@2024!

# ===== SSO / OpenID Connect =====
SSO_ENABLED=false

# Provider OIDC discovery URL
# Azure AD:   https://login.microsoftonline.com/{tenant-id}/v2.0
# Keycloak:   https://keycloak.example.com/realms/{realm}
# Auth0:      https://{domain}.auth0.com
SSO_ISSUER=

SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:3000/auth/sso/callback
SSO_FRONTEND_REDIRECT_URL=http://localhost:4200/sso/callback
SSO_SCOPES=openid profile email
SSO_DEFAULT_ROLE=USER

# ===== Security — Rate Limiting =====
RATE_LIMIT_GLOBAL_TTL=60000
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_LOGIN_TTL=60000
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_REGISTER_TTL=60000
RATE_LIMIT_REGISTER_LIMIT=3

# ===== Security — IP Blocking =====
IP_BLOCK_MAX_FAILED_ATTEMPTS=10
IP_BLOCK_DURATION_MS=900000
IP_BLOCK_WINDOW_MS=600000

# ===== Security — CORS =====
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true
